// Fase 2: una tabla por módulo (dólar y cripto no comparten modelo).
// Los ids de las operaciones los genera el cliente (`crypto.randomUUID()`): permite
// updates optimistas sin reconciliar ids y subir datos locales sin duplicar (Fase 3).
// Montos como `Decimal` sin precisión fija (numeric de Postgres): guardan exacto lo
// que manda el cliente; la conversión a `number` vive en `src/server/mappers.ts`.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TransactionType {
  BUY
  SELL
}

enum FeeCurrency {
  USD
  COIN
}

/// Variante de operación; null = compra/venta normal
/// Con qué se paga o se cobra un CEDEAR: ARS → pata en Pesos; CCL → pata en el Dólar CCL
enum CedearCurrency {
  ARS
  CCL
}

enum OperationKind {
  /// Resultado de un trade acreditado en la moneda (BUY = ganancia, SELL = pérdida)
  TRADE_RESULT
}

model User {
  /// userId de Clerk (`user_…`); la fila se crea en la primera escritura
  id                 String              @id
  createdAt          DateTime            @default(now())
  dolarTransactions  DolarTransaction[]
  cryptoTransactions CryptoTransaction[]
  pesosMovements     PesosMovement[]
  cedearTransactions CedearTransaction[]
}

model DolarTransaction {
  id            String          @id @db.Uuid
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Valor de `DolarOption` ('blue', 'oficial', …); validado con Zod en la API
  dolarOption   String
  type          TransactionType
  dollarsAmount Decimal
  pesosAmount   Decimal
  date          DateTime
  /// Enlaza esta pata (grupo `cripto` = USDT) con la del módulo cripto de un intercambio USDT ↔ cripto
  usdtSwapId    String?         @db.Uuid
  /// Enlaza esta pata con el movimiento de Pesos de una conversión pesos ↔ dólar
  conversionId  String?         @db.Uuid
  /// Pata (grupo `contadoconliqui`) de una operación de CEDEAR: guarda el id de la operación
  cedearId      String?         @db.Uuid
  kind          OperationKind?
  note          String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([userId, dolarOption, date])
  @@index([usdtSwapId])
  @@index([conversionId])
  @@index([cedearId])
}

model CryptoTransaction {
  id          String          @id @db.Uuid
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// id de CoinGecko, ej. `bitcoin`
  coinId      String
  /// Metadatos de la moneda, para mostrarla sin consultar CoinGecko
  symbol      String
  name        String
  image       String?
  type        TransactionType
  quantity    Decimal
  priceUsd    Decimal
  date        DateTime
  /// Comisión opcional: los dos campos van juntos (o ninguno)
  feeAmount   Decimal?
  feeCurrency FeeCurrency?
  /// Enlaza la venta y la compra de un intercambio cripto ↔ cripto
  swapId      String?         @db.Uuid
  /// Enlaza esta pata con la del módulo dólar (USDT) de un intercambio USDT ↔ cripto
  usdtSwapId  String?         @db.Uuid
  kind        OperationKind?
  note        String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([userId, coinId, date])
  @@index([swapId])
  @@index([usdtSwapId])
}

/// Saldo en pesos (Fase 8): BUY = ingreso, SELL = egreso
model PesosMovement {
  id           String          @id @db.Uuid
  userId       String
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         TransactionType
  amount       Decimal
  date         DateTime
  note         String?
  /// Enlaza esta pata con la del módulo dólar de una conversión pesos ↔ dólar
  conversionId String?         @db.Uuid
  /// Pata de una operación de CEDEAR pagada o cobrada en pesos: guarda el id de la operación
  cedearId     String?         @db.Uuid
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([userId, date])
  @@index([conversionId])
  @@index([cedearId])
}

/// Compra o venta de CEDEARs; su pata (Pesos o Dólar CCL) guarda este id en `cedearId`
model CedearTransaction {
  id        String          @id @db.Uuid
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Ticker base en BYMA ('AAPL', 'BA.C'); validado con Zod en la API
  ticker    String
  type      TransactionType
  /// CEDEARs enteros (Decimal como el resto de las cantidades)
  quantity  Decimal
  /// Por CEDEAR, en `currency`
  price     Decimal
  currency  CedearCurrency
  /// ARS por USD CCL ese día
  fxRate    Decimal
  /// Comisión + derechos, en `currency`
  fee       Decimal?
  date      DateTime
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([userId, ticker, date])
}
