# CoinGecko (opcional). Sin clave se usa la API pública, con rate limit más bajo.
# Clave "Demo" gratuita: https://www.coingecko.com/en/api/pricing
COINGECKO_API_KEY=

# Clerk (Fase 1: login). Claves del Dashboard de Clerk → API keys.
# Sin ellas, en dev Clerk arranca en "keyless mode" con claves temporales.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Neon + Prisma (Fase 2). Dashboard de Neon → Connect.
# DATABASE_URL: conexión con pooler (host con `-pooler`), la usa la app vía @prisma/adapter-neon.
# DIRECT_URL: conexión directa (mismo host sin `-pooler`), la usa `prisma migrate`.
# Sin DIRECT_URL, las migraciones usan DATABASE_URL.
DATABASE_URL=
DIRECT_URL=

# E2E con sesión (`pnpm test:e2e --project=cloud`): usan las claves de arriba, que tienen que ser de
# Clerk *desarrollo* y de una rama de Neon que NO sea producción (borran los datos del usuario de prueba).
# Opcional: email del usuario de prueba (por defecto e2e+clerk_test@example.com).
E2E_CLERK_USER_EMAIL=
